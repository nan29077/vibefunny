# ===========================================================================
# .dockerignore — Docker 빌드 컨텍스트에서 제외할 파일/폴더
# ===========================================================================

# 의존성 (빌드 중 npm ci 로 새로 설치)
node_modules

# Next.js 빌드 출력 (빌드 중 새로 생성)
.next
.next-*
out

# 런타임 데이터 (볼륨으로 관리)
# data/db.json 과 data/private-uploads/ 는 컨테이너 외부 볼륨으로 마운트
data/

# 환경변수 파일 (컨테이너 런타임에서 주입)
.env
.env.*
!.env.example

# Git
.git
.gitignore

# 개발 전용 파일
*.tsbuildinfo
npm-debug.log*
.DS_Store

# 스크립트 (선택적 — 배포에 포함하려면 아래 주석 해제)
# scripts/

# 로컬 임시 파일
*.tmp
*.bak
