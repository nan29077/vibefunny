# ===========================================================================
# VIBEFUNNY 환경변수 예시
# ---------------------------------------------------------------------------
# 로컬 모드(기본): 아래 값이 없어도 즉시 실행됩니다.
#   DATABASE_TYPE=json   ->  /data/db.json 파일 기반 데이터 스토어 + Mock Auth
#   STORAGE_TYPE=local   ->  /data/private-uploads 로컬 디스크 저장
# ---------------------------------------------------------------------------

# ===========================================================================
# Auth / Session
# ===========================================================================

# 세션 쿠키 서명용 시크릿 (운영 시 반드시 32자 이상 랜덤 값으로 변경)
SESSION_SECRET=change-me-in-production
DATA_ENCRYPTION_KEY=change-me-to-at-least-32-random-characters
EMAIL_VERIFICATION_HASH_SECRET=change-me-email-verification-secret

# ===========================================================================
# Email (Resend)
# ===========================================================================

# 회원가입 이메일 인증 발송용 (https://resend.com)
RESEND_API_KEY=

# ===========================================================================
# File Storage
# ===========================================================================

# STORAGE_TYPE=local   → /data/private-uploads 로컬 디스크 (기본값)
# STORAGE_TYPE=s3      → AWS S3 (아래 AWS 변수 필요)
STORAGE_TYPE=local

# AWS S3 설정 (STORAGE_TYPE=s3 일 때만 사용)
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===========================================================================
# Database
# ===========================================================================

# DATABASE_TYPE=json      → /data/db.json 파일 기반 (기본값, 로컬/MVP)
# DATABASE_TYPE=postgres  → PostgreSQL (추후 Supabase/RDS 전환 시)
DATABASE_TYPE=json

# PostgreSQL 연결 문자열 (DATABASE_TYPE=postgres 일 때만 사용)
DATABASE_URL=

# ===========================================================================
# App
# ===========================================================================

# 공개 사이트 URL (레퍼럴 링크 생성 등에 사용)
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# 결제 프로바이더: mock | toss  (현재 MVP는 mock 구현)
PAYMENT_PROVIDER=mock

NODE_ENV=development

# Next.js 빌드 출력 디렉토리 (Docker 빌드 시 .next 로 설정)
VF_NEXT_DIST_DIR=.next-vibefunny

# ===========================================================================
# [TODO] Toss Payments 전환 시 사용 (PAYMENT_PROVIDER=toss)
# ===========================================================================
# TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=

# ===========================================================================
# 운영 최초 실행 시 최고관리자 (운영 모드에서는 데모 계정을 만들지 않음)
# ===========================================================================
# ADMIN_EMAIL=
# ADMIN_PASSWORD=   # 영문+숫자 10자 이상
# ADMIN_NAME=최고관리자

# ===========================================================================
# AI 숏츠 제작
# ---------------------------------------------------------------------------
# AI 공급사 API 키는 여기가 아니라 최고관리자 화면(AI 숏츠 > AI 공급사·모델)에서 등록합니다.
# (DATA_ENCRYPTION_KEY 로 암호화 저장되므로 이 키를 바꾸면 다시 입력해야 합니다)
# ===========================================================================
# FFMPEG_PATH=           # 비우면 ffmpeg-static 패키지 → 시스템 ffmpeg 순으로 찾음
# AI_ENGINE=off          # 이 서버에서 AI 작업을 처리하지 않을 때만
# AI_ENGINE_MULTI=1      # AI 작업 서버를 여러 대(서로 시계가 어긋날 수 있는 다른 기계) 동시에 돌릴 때만.
#                        #   기본: 실행 중인 작업은 30초마다 임대를 연장(heartbeat)하고, 임대가 끝났거나 heartbeat 가
#                        #   2분 넘게 끊긴 작업만 다른 프로세스가 회수한다(재시작 시 즉시 빼앗지 않음 → 중복 호출 방지).
#                        #   =1 이면 heartbeat 기준 조기 회수를 하지 않고 임대 만료(6~15분)만 기준으로 회수한다.
# AI_ALLOW_MOCK=1        # 운영에서 개발용 가짜 AI 허용(스테이징 시험용, 실서비스 금지)
# AI_MOCK_DELAY_MS=0     # 개발용 가짜 AI 응답 지연(밀리초). 진행 화면 시험용

# ===========================================================================
# 보안 · 백그라운드 작업
# ===========================================================================
# 앞단 프록시(로드밸런서·nginx) 개수. 운영은 반드시 프록시 뒤에서 실행하세요.
# X-Forwarded-For 에서 오른쪽부터 이 개수만큼 떨어진 값을 실제 접속 IP로 사용합니다(기본 1).
# TRUSTED_PROXY_HOPS=1
# 인증메일 전체 발송 한도(시간당, 최소 50 · 기본 300). 수신자 1명당은 하루 10통으로 고정.
# EMAIL_SEND_HOURLY_LIMIT=300
# 마감일이 지난 캠페인 자동 정산(서버 시작 10초 후 + 30분마다). 끄려면 off
# CAMPAIGN_SWEEP=off
